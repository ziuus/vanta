/* ── Graphs / trends screen ── */
/* CSS variable defaults — overridden at runtime by apply_theme() */
$bg: #0a0a0f;
$surface: #0f0f1a;
$surface-alt: #1a1a2e;
$border: #1e1e3f;
$text: #cbd5e1;
$text-muted: #64748b;
$text-dim: #4a5568;
$accent: #06b6d4;
$green: #22c55e;
$yellow: #eab308;
$red: #ef4444;
$error-bg: rgba(239, 68, 68, 0.12);
$overlay-bg: rgba(10, 10, 15, 0.88);
$overlay-surface: #0f0f1a;

#graphs-body {
    padding: 0 1;
}

.graphs-status {
    height: 1;
    background: $bg;
    color: $text-dim;
    margin-bottom: 1;
    padding: 0 1;
}

#graphs-row-top,
#graphs-row-bottom {
    height: 1fr;
    margin-bottom: 1;
}

.graph-panel {
    width: 1fr;
    border: solid $border;
    background: $surface;
    color: $text;
    padding: 1;
    margin-right: 1;
}

#graphs-row-top > .graph-panel:last-child,
#graphs-row-bottom > .graph-panel:last-child {
    margin-right: 0;
}

.compact .graph-panel {
    padding: 0 1;
}

.tiny #graphs-row-top,
.tiny #graphs-row-bottom {
    height: auto;
}

.tiny .graph-panel {
    min-height: 6;
    padding: 0 1;
}

.vanta-light .graphs-status {
    background: $bg;
}

.vanta-light .graph-panel {
    border: solid $border;
    background: $surface;
    color: $text;
}
