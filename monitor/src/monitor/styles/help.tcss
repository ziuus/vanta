/* ── Help overlay screen ── */
/* CSS variable defaults — overridden at runtime by apply_theme() */
$bg: #0a0a0f;
$surface: #0f0f1a;
$surface-alt: #1a1a2e;
$border: #1e1e3f;
$text: #cbd5e1;
$text-muted: #64748b;
$text-dim: #4a5568;
$accent: #06b6d4;
$green: #22c55e;
$yellow: #eab308;
$red: #ef4444;
$error-bg: rgba(239, 68, 68, 0.12);
$overlay-bg: rgba(10, 10, 15, 0.88);
$overlay-surface: #0f0f1a;

HelpOverlay {
    align: center middle;
    background: $overlay-bg;
}

#help-modal {
    width: 60;
    height: auto;
    border: solid $accent;
    background: $overlay-surface;
    padding: 1 2;
}

#help-title {
    text-style: bold;
    padding: 0 0 1 0;
    text-align: center;
    color: $text;
}

.help-category {
    text-style: bold;
    padding: 1 0 0 0;
    border-top: solid $border;
    color: $text-muted;
}

.help-row {
    height: 1;
    padding: 0 1;
}

.help-key {
    width: 10;
    color: $text;
}

.help-desc {
    width: 1fr;
    color: $text-dim;
}

#help-footer {
    text-align: center;
    padding: 1 0 0 0;
    color: $text-dim;
}

.vanta-light HelpOverlay {
    background: $overlay-bg;
}

.vanta-light .overlay-bg {
    background: rgba(255, 255, 255, 0.90);
}
